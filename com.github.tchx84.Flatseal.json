{
    "app-id": "com.github.tchx84.Flatseal",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "separate-locales": false,
    "command": "com.github.tchx84.Flatseal",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=/var/lib/flatpak/app:ro",
        "--filesystem=xdg-data/flatpak/app:ro",
        "--filesystem=xdg-data/flatpak/overrides:create",
        "--talk-name=org.gnome.Software",
        "--talk-name=org.freedesktop.impl.portal.PermissionStore"
    ],
    "modules": [
        {
            "name": "libfyaml",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DENABLE_NETWORK=OFF",
                "-DENABLE_LIBCLANG=OFF",
                "-DBUILD_TESTING=OFF"
            ],
            "cleanup": [
                "/bin",
                "/include",
                "/lib/pkgconfig",
                "/share/man"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/pantoniou/libfyaml/releases/download/v0.9.6/libfyaml-0.9.6.tar.gz",
                    "sha256": "a59cc3331e2eb903ec36933ad52a45888041cac31e44f553a00511131242c483",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/pantoniou/libfyaml/releases",
                        "version-query": "[.[] | select(.prerelease == false and (.tag_name | test(\"^v[0-9.]+$\")))] | first | .tag_name | sub(\"^v\"; \"\")",
                        "url-query": "\"https://github.com/pantoniou/libfyaml/releases/download/v\" + $version + \"/libfyaml-\" + $version + \".tar.gz\""
                    }
                }
            ]
        },
        {
            "name": "libxmlb",
            "buildsystem": "meson",
            "config-opts": [
                "-Dstemmer=false",
                "-Dintrospection=false",
                "-Dgtkdoc=false",
                "-Dtests=false",
                "-Dcli=false"
            ],
            "cleanup": [
                "/include",
                "/lib/pkgconfig",
                "/libexec",
                "/share/installed-tests"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/hughsie/libxmlb.git",
                    "tag": "0.3.29",
                    "commit": "d942cd68a7d78e35b312b9299e69f68f9cd2e503",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name": "appstream",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgir=true",
                "-Dcompose=false",
                "-Dman=false",
                "-Dapidocs=false",
                "-Dstemming=false",
                "-Dblake3-support=false",
                "-Dsystemd=false",
                "-Dbash-completion=false",
                "-Dvapi=false",
                "-Dqt=false"
            ],
            "cleanup": [
                "/bin",
                "/include",
                "/lib/pkgconfig",
                "/share/gir-1.0",
                "/share/installed-tests"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/ximion/appstream.git",
                    "tag": "v1.2.1",
                    "commit": "4e3a4de973810e25bbada1b822185ed4d90eb1f5",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name": "flatseal",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/tchx84/Flatseal.git",
                    "tag": "v2.4.1",
                    "commit": "3516a94d25e9f9632dae2f78fb604af1e5b14981"
                }
            ]
        }
    ]
}
